NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:3001

# Database
DATABASE_URL=postgres://clipzen:clipzen@localhost:5432/clipzen
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clipzen
DB_USER=clipzen
DB_PASSWORD=clipzen

# App auth and token encryption
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_SECRET=replace-with-at-least-32-random-characters

# ── Transactional email (Resend) ─────────────────────────────────
# Sign up at https://resend.com — free tier: 3,000 emails/mo, 100/day, instant.
# 1. Create an API key:  https://resend.com/api-keys
# 2. For dev, you can use the "onboarding@resend.dev" sender below — no domain
#    verification required.
# 3. For production, verify your sending domain (clipzen.ai) at
#    https://resend.com/domains and switch EMAIL_FROM to a noreply@clipzen.ai
#    address.
RESEND_API_KEY=re_replace_with_your_resend_api_key
EMAIL_FROM="Clipzen <onboarding@resend.dev>"
# Public URL for the logo used in transactional email templates.
LOGO_URL=https://clipzen.ai/logo.png

# ── Google OAuth (Sign in with Google) ───────────────────────────
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID → Application type: Web application
# 3. Authorized redirect URIs: add GOOGLE_REDIRECT_URI below for each env
# 4. Configure the OAuth consent screen (External) and add scopes:
#    openid, email, profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# ── Transcription engine ─────────────────────────────────────────
# IS_WHISPER=true forces the local OpenAI Whisper setup (previous setup).
# Leave it false/unset to use Speechmatics (current default).
IS_WHISPER=true

# ── Transcription (Speechmatics) ─────────────────────────────────
# Primary speech-to-text engine. Supports 55+ languages with word-level
# timestamps. Get a key at https://portal.speechmatics.com → API keys.
# The per-job language is chosen in the Create Job modal (default "en";
# use "auto" for automatic language identification).
SPEECHMATICS_API_KEY=
# Optional overrides (sensible defaults applied if omitted):
# SPEECHMATICS_API_URL=https://asr.api.speechmatics.com/v2
# SPEECHMATICS_OPERATING_POINT=enhanced   # enhanced (accuracy) | standard (speed)
# SPEECHMATICS_POLL_TIMEOUT_MS=1800000    # max wait for a batch job (30 min)
# SPEECHMATICS_POLL_INTERVAL_MS=4000      # status poll interval
# SPEECHMATICS_MAX_GAP_SEC=1.5            # silence gap that splits a segment
#
# Fallback engine: local OpenAI Whisper (only used if SPEECHMATICS_API_KEY is unset)
# PYTHON_PATH=python3
# WHISPER_MODEL=base
# WHISPER_THREADS=8

# Storage and workers
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
REDIS_HOST=localhost
REDIS_PORT=6379

# Cloudinary Config
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Future n8n publishing handoff. n8n receives publish payloads only; it does not run OAuth.
N8N_WEBHOOK_URL=

# YouTube / Google Cloud Console
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3001/api/auth/youtube/callback

# TikTok Developer Portal
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3001/api/auth/tiktok/callback

# Meta Developer App, used by Instagram and Facebook
META_CLIENT_ID=
META_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3001/api/auth/instagram/callback
FACEBOOK_REDIRECT_URI=http://localhost:3001/api/auth/facebook/callback

# LinkedIn Developer App
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3001/api/auth/linkedin/callback

# Twitter/X Developer Portal
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:3001/api/auth/twitter/callback

# Provider setup notes
# Google Cloud Console: create an OAuth 2.0 Web Client, enable YouTube Data API v3,
# add YOUTUBE_REDIRECT_URI as an authorized redirect URI, then request/verify scopes
# for youtube.readonly and youtube.upload before production use.
# Meta Developer App: add Facebook Login and Instagram Graph API, configure the Meta
# redirect URIs above, connect a Facebook Page and Instagram professional account, and
# request pages_manage_posts, pages_show_list, instagram_basic, and instagram_content_publish.
# TikTok Developer Portal: create a web app, add TIKTOK_REDIRECT_URI, and request
# user.info.basic, video.upload, and video.publish scopes.
# LinkedIn Developer App: add LINKEDIN_REDIRECT_URI under Auth, enable Sign In with
# LinkedIn using OpenID Connect and Community Management API access for w_member_social.
# Twitter/X Developer Portal: enable OAuth 2.0, add TWITTER_REDIRECT_URI, and request
# tweet.read, tweet.write, users.read, and offline.access scopes.

# ── Billing: Lemon Squeezy ────────────────────────────────────────
# Minutes-based credits. New users get FREE_SIGNUP_MINUTES once; plans grant a
# monthly allowance (Starter 140 / Pro 400 / Advanced 1000); PAYG packs add
# non-expiring credit minutes. Get keys at https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
# Webhook signing secret — set the SAME value in LS → Settings → Webhooks.
# Webhook URL to register: {BACKEND_PUBLIC_URL}/api/billing/webhooks/lemonsqueezy
# Subscribe to: subscription_created, subscription_updated, subscription_payment_success,
#               subscription_cancelled, subscription_expired, subscription_paused, order_created
LEMONSQUEEZY_WEBHOOK_SECRET=

# Variant IDs from each product's variant in the LS dashboard (Products → variant → ID).
LS_VARIANT_STARTER_MONTHLY=
LS_VARIANT_STARTER_YEARLY=
LS_VARIANT_PRO_MONTHLY=
LS_VARIANT_PRO_YEARLY=
LS_VARIANT_ADVANCED_MONTHLY=
LS_VARIANT_ADVANCED_YEARLY=
# Pay-as-you-go credit packs (one-time purchases).
LS_VARIANT_PAYG_SMALL=
LS_VARIANT_PAYG_MEDIUM=
LS_VARIANT_PAYG_LARGE=
# Future: automation add-on (kept in maintenance for now).
LS_VARIANT_AUTOMATION_ADDON=

# Optional overrides (sensible defaults applied if omitted):
# FREE_SIGNUP_MINUTES=20
# PAYG_MINUTES_SMALL=100
# PAYG_MINUTES_MEDIUM=300
# PAYG_MINUTES_LARGE=600
